sudo bash -c 'cat << "EOF" > /etc/nginx/conf.d/cryospawn.conf
server {
    listen 80;
    
    # This matches ANY number, e.g. vm0.cryo, vm1.cryo
    # and stores the number in the $vmid variable
    server_name ~^vm(?<vmid>\d+)\.cryo$;

    location / {
        # Dynamically proxies to the correct Unix socket!
        proxy_pass http://unix:/tmp/cryo_vm_${vmid}_80.sock;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
    }
}

server {
    listen 443;
    server_name ~^vm(?<vmid>\d+)\.cryo$;

    location / {
        # Note: True SSL requires certificates in Nginx, 
        # but this passes it through to the internal HTTPS server!
        proxy_pass https://unix:/tmp/cryo_vm_${vmid}_443.sock;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
    }
}
EOF'

# Reload Nginx to apply the new config instantly
sudo nginx -s reload